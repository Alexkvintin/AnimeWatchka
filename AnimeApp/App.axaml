<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="AnimeApp.App" RequestedThemeVariant="Dark">
  <Application.Resources>
    <SolidColorBrush x:Key="CanvasBrush">#101319</SolidColorBrush>
    <SolidColorBrush x:Key="TextBrush">#EDF0F5</SolidColorBrush>
    <SolidColorBrush x:Key="PanelBrush">#171C24</SolidColorBrush>
    <SolidColorBrush x:Key="SidebarBrush">#171C24</SolidColorBrush>
    <SolidColorBrush x:Key="ButtonBrush">#303440</SolidColorBrush>
    <SolidColorBrush x:Key="MutedBrush">#ADB5C4</SolidColorBrush>
    <SolidColorBrush x:Key="AccentBrush">#8BB8EE</SolidColorBrush>
    <SolidColorBrush x:Key="AccentTextBrush">#101319</SolidColorBrush>
    <SolidColorBrush x:Key="OutlineBrush">#304D6480</SolidColorBrush>
    <SolidColorBrush x:Key="EditorBrush">#171C24</SolidColorBrush>
    <LinearGradientBrush x:Key="AtmosphereBrush" StartPoint="0%,0%" EndPoint="100%,100%"><GradientStop Color="#263244" Offset="0"/><GradientStop Color="#101319" Offset="0.5"/><GradientStop Color="#302535" Offset="1"/></LinearGradientBrush>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <Style Selector="ScrollViewer"><Setter Property="AllowAutoHide" Value="False"/></Style>
    <Style Selector="ScrollBar:vertical"><Setter Property="Width" Value="14"/></Style>
    <Style Selector="ScrollBar:horizontal"><Setter Property="Height" Value="14"/></Style>
    <Style Selector="Button.titleLink:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></Style>
    <Style Selector="Window">
      <Setter Property="Icon" Value="avares://AnimeApp/Assets/app.ico" />
      <Setter Property="Background" Value="{DynamicResource CanvasBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="FontFamily" Value="Segoe UI" />
    </Style>
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="16,11" />
      <Setter Property="Background" Value="{DynamicResource ButtonBrush}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.nav">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Margin" Value="0,3" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="12,10" />
    </Style>
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="Padding" Value="24" /><Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}"/><Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    </Style>
    <Style Selector="TextBlock.h2">
      <Setter Property="FontSize" Value="21" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  <Style Selector="Button.watched"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/><Setter Property="Background" Value="#233327"/></Style>
<Style Selector="Button.partial"><Setter Property="Foreground" Value="#F5C97A"/></Style>
<Style Selector="Button.current"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="BorderThickness" Value="2"/></Style>
<Style Selector="ListBoxItem /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/></Style>
<Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/></Style>
<Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/></Style>
<Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent"/></Style>
<Style Selector="Button.nav"><Setter Property="Padding" Value="12,10"/></Style>
<Style Selector="Button.nav.active"><Setter Property="Background" Value="{DynamicResource ButtonBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></Style>
</Application.Styles>
</Application>


