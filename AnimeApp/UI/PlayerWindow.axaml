<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="AnimeApp.UI.PlayerWindow" Width="1200" Height="800" MinWidth="800" MinHeight="550" Title="AnimeWatchka · Просмотр" Background="#0D1018" Foreground="#E9EDF6" RequestedThemeVariant="Dark">
 <Window.Resources>
  <SolidColorBrush x:Key="ButtonBrush">#222838</SolidColorBrush>
  <SolidColorBrush x:Key="TextBrush">#E9EDF6</SolidColorBrush>
  <SolidColorBrush x:Key="MutedBrush">#ADB5C4</SolidColorBrush>
 </Window.Resources>
 <Window.Styles>
  <Style Selector="Button"><Setter Property="CornerRadius" Value="10"/><Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="12,7"/><Setter Property="FontSize" Value="13"/></Style>
  <Style Selector="ToggleButton"><Setter Property="CornerRadius" Value="10"/><Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="12,7"/></Style>
  <Style Selector="ComboBox"><Setter Property="CornerRadius" Value="8"/></Style>
 </Window.Styles>
 <Grid x:Name="PlayerRoot" RowDefinitions="Auto,*,Auto" Margin="20">
  <Grid x:Name="Header" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,15"><Button Content="← Назад" Command="{Binding BackCommand}"/><StackPanel Grid.Column="1" Margin="20,0"><TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding EpisodeLabel}" Classes="muted"/></StackPanel><Button Grid.Column="2" Content="⛶ Полный экран" Command="{Binding FullscreenCommand}"/></Grid>
  <Border Grid.Row="1" Background="Black"><ContentControl x:Name="Surface" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/></Border>
  <Border x:Name="Controls" Grid.Row="2" Margin="0,8,0,0" Background="#ED151923" BorderBrush="#405F6A82" BorderThickness="1" CornerRadius="18" Padding="18,12"><StackPanel Spacing="6">
   <TextBlock Text="{Binding EpisodeLabel}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
   <TextBlock Text="{Binding Status}" IsVisible="{Binding ShowStatus}" TextWrapping="Wrap" Foreground="#B5F279"/>
   <Grid ColumnDefinitions="*,Auto,Auto"><Slider x:Name="Timeline" Minimum="0" Maximum="{Binding Duration}" Value="{Binding SeekPosition}" IsEnabled="{Binding CanControl}"/><TextBlock Grid.Column="1" Text="{Binding TimeLabel}" MinWidth="125" VerticalAlignment="Center" Margin="15,0,0,0"/><Button Grid.Column="2" Content="⛶" Command="{Binding FullscreenCommand}" ToolTip.Tip="Полный экран / выйти · Esc" AutomationProperties.Name="Войти или выйти из полного экрана" Margin="12,0,0,0"/></Grid>
   <WrapPanel>
    <Button Content="⏮" Command="{Binding PreviousCommand}" IsEnabled="{Binding HasPrevious}" ToolTip.Tip="Предыдущая серия" AutomationProperties.Name="Предыдущая серия"/>
    <Button Content="{Binding PlayLabel}" Command="{Binding TogglePlayCommand}" IsEnabled="{Binding CanControl}" Margin="6,0"/>
    <Button Content="⏭" Command="{Binding NextCommand}" IsEnabled="{Binding HasNext}" ToolTip.Tip="Следующая серия" AutomationProperties.Name="Следующая серия"/>
    <TextBlock Text="Звук" VerticalAlignment="Center" Margin="10,0,4,0"/><Slider Minimum="0" Maximum="100" Value="{Binding Volume}" Width="85" IsEnabled="{Binding CanControl}" AutomationProperties.Name="Громкость"/>
    <Button Content="+90 с" Command="{Binding SkipOpeningCommand}" ToolTip.Tip="Пропустить опенинг · O" IsEnabled="{Binding CanControl}" Margin="6,0"/>
    <ToggleButton x:Name="EnhancementToggle" Content="✦ Улучшение" IsChecked="{Binding ScalingEnabled}" IsEnabled="{Binding CanChangeScaling}" ToolTip.Tip="{Binding ScalingHint}" AutomationProperties.Name="Улучшение изображения" Margin="0,0,6,0"/>
    <ToggleButton Content="CC" IsChecked="{Binding ShowSubtitles}" IsEnabled="{Binding CanUseSubtitles}" ToolTip.Tip="Субтитры" AutomationProperties.Name="Субтитры" Margin="0,0,6,0"/>
    <ToggleButton x:Name="OptionsToggle" Content="⚙" IsChecked="{Binding ShowOptions}" ToolTip.Tip="Настройки видео" AutomationProperties.Name="Настройки видео"/>
    <Button Content="{Binding ResumeLabel}" Command="{Binding ResumeCommand}" IsVisible="{Binding ShowResume}" Margin="6,0"/>
   </WrapPanel>
   <ScrollViewer IsVisible="{Binding ShowSubtitles}" MaxHeight="190" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
    <StackPanel Spacing="8" Margin="4,8,16,8">
     <WrapPanel><ComboBox ItemsSource="{Binding SubtitleTracks}" SelectedItem="{Binding SelectedSubtitle}" MinWidth="180" MaxWidth="430"/><Button Content="Открыть субтитры…" Click="OpenSubtitleFile" Margin="8,0"/></WrapPanel>
     <WrapPanel><TextBlock Text="Задержка, секунды" VerticalAlignment="Center" Margin="0,0,12,0"/><NumericUpDown Value="{Binding SubtitleDelay}" Minimum="-120" Maximum="120" Increment="0.1" FormatString="0.0" Width="140"/></WrapPanel>
     <TextBlock Text="{Binding SubtitleHint}" TextWrapping="Wrap" Classes="muted"/>
    </StackPanel>
   </ScrollViewer>
   <ScrollViewer IsVisible="{Binding ShowOptions}" MaxHeight="190" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
    <StackPanel Spacing="12" Margin="4,8,16,8">
     <WrapPanel IsVisible="{Binding HasStreamQualities}" IsEnabled="{Binding !Loading}"><TextBlock Text="Качество видео" VerticalAlignment="Center" Margin="0,0,12,0"/><ComboBox ItemsSource="{Binding StreamQualities}" SelectedItem="{Binding SelectedStreamQuality}" Width="120"/><Button Content="Применить" Command="{Binding ApplyStreamQualityCommand}" Margin="8,0"/></WrapPanel>
     <WrapPanel><TextBlock Text="Скорость" VerticalAlignment="Center" Margin="0,0,8,0"/><Slider Minimum="0.5" Maximum="2" TickFrequency="0.25" IsSnapToTickEnabled="True" Value="{Binding Speed}" Width="120" IsEnabled="{Binding CanControl}"/><TextBlock Text="{Binding SpeedLabel}" VerticalAlignment="Center" Margin="8,0"/></WrapPanel>
     <WrapPanel ToolTip.Tip="{Binding ScalingHint}"><TextBlock Text="Режим улучшения" VerticalAlignment="Center"/><ComboBox ItemsSource="{Binding ScalingModes}" SelectedItem="{Binding SelectedScaling}" IsEnabled="{Binding CanChangeScaling}" Width="200" Margin="12,0"/></WrapPanel>
     <Expander Header="Информация о видео"><TextBlock x:Name="VideoInfo" TextWrapping="Wrap"/></Expander>
    </StackPanel>
   </ScrollViewer>
   <WrapPanel><Button Classes="primary" Content="Следующая серия →" Command="{Binding NextCommand}" IsVisible="{Binding ShowNext}" Margin="0,0,12,0"/><Button Content="Отметить аниме как просмотренное" Command="{Binding CompleteCommand}" IsVisible="{Binding CanComplete}"/><Button Content="Не сейчас" Command="{Binding DismissCompleteCommand}" IsVisible="{Binding CanComplete}" Margin="10,0"/></WrapPanel>
  </StackPanel></Border>
 </Grid>
</Window>


